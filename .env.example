# LDSS Environment Configuration
# All features work 100% offline with zero keys. These keys enable live watsonx.ai Granite models if present.

# IBM watsonx.ai Credentials (Optional)
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-13b-instruct-v2

# Frontend Configuration
VITE_OFFLINE_SNAPSHOT=false
VITE_WATSONX_PROXY_URL=http://localhost:3001
